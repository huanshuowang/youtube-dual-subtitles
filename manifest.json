{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "2.0.0",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://vimeo.com/*",
    "*://player.vimeo.com/*",
    "https://www.bilibili.com/*",
    "https://captions.vimeo.com/*",
    "https://api.bilibili.com/*",
    "https://translate.googleapis.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.deepseek.com/*"
  ],
  "action": {
    "default_title": "HappySubs",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "i18n.js",
        "platform.js",
        "live.js",
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://vimeo.com/*",
        "*://player.vimeo.com/*"
      ],
      "js": [
        "i18n.js",
        "platform.js",
        "live.js",
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.bilibili.com/*"
      ],
      "js": [
        "i18n.js",
        "platform.js",
        "live.js",
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject-youtube.js"
      ],
      "matches": [
        "*://www.youtube.com/*"
      ]
    },
    {
      "resources": [
        "inject-vimeo.js"
      ],
      "matches": [
        "*://vimeo.com/*",
        "*://player.vimeo.com/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
